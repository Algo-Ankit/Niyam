{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm ci --prefix web && npm run build --prefix web -- --outDir ../public --emptyOutDir",
  "functions": {
    "src/niyam/asgi.py": {
      "maxDuration": 60,
      "excludeFiles": "{web/**,public/**,data/raw/**,data/processed/**,results/**,evals/**,tests/**,docs/**,scripts/**,notes/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
