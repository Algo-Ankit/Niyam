# Copy to .env and fill in. Never commit .env.

# Decision model route: gemini (gemini-decision-1 on the Gemini API free tier)
DECISION_PROVIDER=gemini
# Hard cap on decision-model spend, USD (0 on the free tier)
DECISION_BUDGET_USD=0
# Gemini API key (Google AI Studio); used for decisions, generation and embeddings
GEMINI_API_KEY=
# Langfuse keys (public starts pk-lf-, secret starts sk-lf-) and host
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
LANGFUSE_TRACING=true
# Postgres (Neon) direct connection string
DATABASE_URL=
# Max demo questions per day
DEMO_DAILY_CAP=
