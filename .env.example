# Copy to .env and fill in. Never commit .env.

# Route to Jev: vercel | openrouter | none
JEV_PROVIDER=vercel
# Vercel AI Gateway API key
JEV_API_KEY=
# Hard cap on total Jev spend, USD
JEV_BUDGET_USD=5
# Gemini API key (Google AI Studio)
GEMINI_API_KEY=
# Langfuse keys and host
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
# Postgres (Neon) connection string
DATABASE_URL=
# Max demo questions per day
DEMO_DAILY_CAP=
